{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev:canvas": {
      "cache": false
    },
    "dev:plugin": {
      "cache": false
    },
    "build:canvas": {
      "outputs": ["dist/**"]
    },
    "build:plugin": {
      "outputs": ["dist/**"]
    }
  }
}
